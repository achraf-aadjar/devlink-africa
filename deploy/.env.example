# Copier vers deploy/.env sur le serveur et remplir. Ne JAMAIS commiter deploy/.env.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=example.org
CORS_ALLOWED_ORIGINS=https://example.org
CSRF_TRUSTED_ORIGINS=https://example.org
SECURE_SSL_REDIRECT=True

# PostgreSQL (le service "db" lit aussi ces valeurs)
DB_ENGINE=postgresql
DB_NAME=devlink
DB_USER=devlink
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
