# Copier vers deploy/.env sur le serveur et remplir. Ne JAMAIS commiter deploy/.env.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=example.org
CORS_ALLOWED_ORIGINS=https://example.org
CSRF_TRUSTED_ORIGINS=https://example.org
SECURE_SSL_REDIRECT=True
# Base des liens envoyés par e-mail (mot de passe oublié). Sans elle, les liens
# pointent vers http://localhost:5173.
FRONTEND_URL=https://example.org

# PostgreSQL (le service "db" lit aussi ces valeurs)
DB_ENGINE=postgresql
DB_NAME=devlink
DB_USER=devlink
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# --- Facultatif ---
# E-mail : sans EMAIL_HOST, les messages (lien de réinitialisation) s'écrivent
# dans les journaux du conteneur backend au lieu de partir.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=DevLink Africa <no-reply@devlink.africa>

# Fonctions d'IA : le produit fonctionne sans elles.
# AI_ENABLED=True
# AI_API_KEY=

# Connexion avec Google : déclarer https://example.org comme origine autorisée
# dans Google Cloud Console, sinon le bouton échoue.
# GOOGLE_CLIENT_ID=
