# Copier vers backend/.env (ne jamais commiter .env).
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Base de données : postgresql (défaut) ou sqlite
DB_ENGINE=postgresql
DB_NAME=devlink
DB_USER=devlink
DB_PASSWORD=devlink
DB_HOST=127.0.0.1
DB_PORT=5432
# Uniquement si DB_ENGINE=sqlite :
# DATABASE_PATH=db.sqlite3

# Optionnel (production, DEBUG=False)
# CSRF_TRUSTED_ORIGINS=https://example.org
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# --- Fonctions d'IA (facultatives, DL-41 à DL-47) ---
# Le produit fonctionne entièrement sans elles. Laissez AI_ENABLED=False si vous
# n'avez pas de clé : l'interface proposera les formulaires classiques.
AI_ENABLED=False
# AI_API_KEY=            (ne jamais commiter cette valeur)
# AI_MODEL=claude-haiku-4-5-20251001
# AI_DAILY_LIMIT=200
