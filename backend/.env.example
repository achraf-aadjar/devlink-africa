# Copier vers backend/.env (ne jamais commiter .env).
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
DATABASE_PATH=db.sqlite3

# Optionnel (production, DEBUG=False)
# CSRF_TRUSTED_ORIGINS=https://example.org
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
